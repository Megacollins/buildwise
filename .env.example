# PostgreSQL connection string
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/buildwise"
# Optional: AI provider for the design assistant (not required; rule-based assistant is used when absent)
# ANTHROPIC_API_KEY=""
# Optional: scratch DB for `prisma migrate dev` (development only)
# SHADOW_DATABASE_URL=""

# Public URL of the app: Google sign-in returns to APP_URL/api/auth/google/callback (required in production)
APP_URL="https://app.example.com"
# Sign in with Google (the only way to sign in; required in production). Create an OAuth client
# ("Web application") in Google Cloud Console and add the callback URL above as a redirect URI.
# Locally you can skip these and use "Sign in as the local demo user" instead.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: email delivery via Resend (not used for sign-in)
# RESEND_API_KEY=""
# EMAIL_FROM="Buildwise <no-reply@example.com>"

# Hosted Postgres (e.g. Neon): DATABASE_URL = pooled connection, DIRECT_DATABASE_URL = direct connection (used for migrations)
# DIRECT_DATABASE_URL=""
# Secret for the daily cleanup job (/api/cron/cleanup). Generate with: openssl rand -hex 32
CRON_SECRET=""
# Only for seeding a demo account on a non-local database (normally leave unset)
# SEED_DEMO="false"
