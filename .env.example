# PostgreSQL connection string
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/buildwise"
# Optional: AI provider for the design assistant (not required; rule-based assistant is used when absent)
# ANTHROPIC_API_KEY=""
# Optional: scratch DB for `prisma migrate dev` (development only)
# SHADOW_DATABASE_URL=""

# Public URL of the app, used in email links (required in production; never derived from the request)
APP_URL="https://app.example.com"
# Email delivery via Resend (https://resend.com). Without these, development prints emails to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Buildwise <no-reply@example.com>"

# Hosted Postgres (e.g. Neon): DATABASE_URL = pooled connection, DIRECT_DATABASE_URL = direct connection (used for migrations)
# DIRECT_DATABASE_URL=""
# Secret for the daily cleanup job (/api/cron/cleanup). Generate with: openssl rand -hex 32
CRON_SECRET=""
# Only for seeding a demo account on a non-local database (normally leave unset)
# SEED_DEMO="false"
